# ── AI Forensic Engine — configuration ──
#
# Copy this file to src/.env and fill in whichever providers you want.
#
# You need AT LEAST ONE of the three below. The app tries them in this order
# and falls through on failure or absence:
#
#     Ollama (local)  →  Groq (cloud)  →  Gemini (cloud)  →  offline summary
#
# If none is configured the app refuses to start. If all of them fail at query
# time it still answers, from system facts and the retrieved evidence directly,
# without an LLM.


# ── Ollama — local, tried first ───────────────────────────────────────────────
# No API key and no account. Evidence never leaves the machine, which is the
# reason to prefer it: on a real case, sending artifact text to a third-party
# API may be something you are not permitted to do.
#
#   1. Install from https://ollama.com
#   2. ollama serve
#   3. ollama pull llama3.2
#
# Defaults are used if these are unset; set them only to override.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2


# ── Groq — cloud, tried second ────────────────────────────────────────────────
# Free tier available. Get a key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here


# ── Gemini — cloud, tried third ───────────────────────────────────────────────
# Free tier available. Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here


# ── Embedding tuning (optional) ───────────────────────────────────────────────
# Only touch these if an index build fails. See README "Troubleshooting".
#
# FORENSICS_EMBED_BATCH=32        # sets peak memory of the encode process
# FORENSICS_EMBED_CHUNK=500       # resume granularity, not memory
# FORENSICS_EMBED_IN_PROCESS=1    # encode in-process instead of a subprocess
